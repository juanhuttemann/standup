# Default OpenAI-compatible text provider (required unless offline: true)
OPENAI_BASE_URL=
OPENAI_MODEL=
# Anthropic text provider (set provider: anthropic instead; API key must stay secret)
ANTHROPIC_BASE_URL=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
# Speech settings (required for `speak -o` only; the model must support audio output)
OPENAI_SPEECH_MODEL=
OPENAI_SPEECH_VOICE=
