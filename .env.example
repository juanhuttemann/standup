# Default OpenAI-compatible text provider (required unless offline: true)
OPENAI_BASE_URL=
OPENAI_MODEL=
# API key for hosted OpenAI-compatible endpoints (leave empty for endpoints that do not require one)
OPENAI_API_KEY=
# Anthropic text provider (set provider: anthropic instead; API key must stay secret)
ANTHROPIC_BASE_URL=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
# Streaming chat-completions audio model and voice (not tts-1 or /audio/speech)
OPENAI_SPEECH_MODEL=
OPENAI_SPEECH_VOICE=
